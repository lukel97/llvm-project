; Three exits where the middle one sits in a diamond arm. The first and last
; exits dominate the store, but the middle one doesn't, so the exits are not
; totally ordered and the chained cut masks don't apply.
define void @side_effect_middle_exit_in_diamond(ptr dereferenceable(128) %p, ptr dereferenceable(128) %r, ptr dereferenceable(128) %s, ptr noalias %q) {
; CHECK-LABEL: define void @side_effect_middle_exit_in_diamond(
; CHECK-SAME: ptr dereferenceable(128) [[P:%.*]], ptr dereferenceable(128) [[R:%.*]], ptr dereferenceable(128) [[S:%.*]], ptr noalias [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr i8, ptr [[P]], i32 [[IV]]
; CHECK-NEXT:    [[LD1:%.*]] = load i8, ptr [[GEP1]], align 1
; CHECK-NEXT:    [[EE1:%.*]] = icmp eq i8 [[LD1]], 0
; CHECK-NEXT:    br i1 [[EE1]], label %[[EXIT:.*]], label %[[MID:.*]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    [[COND:%.*]] = icmp ult i32 [[IV]], 64
; CHECK-NEXT:    br i1 [[COND]], label %[[LEFT:.*]], label %[[MERGE:.*]]
; CHECK:       [[LEFT]]:
; CHECK-NEXT:    [[GEP2:%.*]] = getelementptr i8, ptr [[R]], i32 [[IV]]
; CHECK-NEXT:    [[LD2:%.*]] = load i8, ptr [[GEP2]], align 1
; CHECK-NEXT:    [[EE2:%.*]] = icmp eq i8 [[LD2]], 0
; CHECK-NEXT:    br i1 [[EE2]], label %[[EXIT]], label %[[MERGE]]
; CHECK:       [[MERGE]]:
; CHECK-NEXT:    [[GEP3:%.*]] = getelementptr i8, ptr [[S]], i32 [[IV]]
; CHECK-NEXT:    [[LD3:%.*]] = load i8, ptr [[GEP3]], align 1
; CHECK-NEXT:    [[EE3:%.*]] = icmp eq i8 [[LD3]], 0
; CHECK-NEXT:    br i1 [[EE3]], label %[[EXIT]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[GEP4:%.*]] = getelementptr i8, ptr [[Q]], i32 [[IV]]
; CHECK-NEXT:    [[LD4:%.*]] = load i8, ptr [[GEP4]], align 1
; CHECK-NEXT:    [[ADD:%.*]] = add i8 [[LD4]], 1
; CHECK-NEXT:    store i8 [[ADD]], ptr [[GEP4]], align 1
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ne i32 [[IV_NEXT]], 128
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %gep1 = getelementptr i8, ptr %p, i32 %iv
  %ld1 = load i8, ptr %gep1
  %ee1 = icmp eq i8 %ld1, 0
  br i1 %ee1, label %exit, label %mid

mid:
  %cond = icmp ult i32 %iv, 64
  br i1 %cond, label %left, label %merge

left:
  %gep2 = getelementptr i8, ptr %r, i32 %iv
  %ld2 = load i8, ptr %gep2
  %ee2 = icmp eq i8 %ld2, 0
  br i1 %ee2, label %exit, label %merge

merge:
  %gep3 = getelementptr i8, ptr %s, i32 %iv
  %ld3 = load i8, ptr %gep3
  %ee3 = icmp eq i8 %ld3, 0
  br i1 %ee3, label %exit, label %latch

latch:
  %gep4 = getelementptr i8, ptr %q, i32 %iv
  %ld4 = load i8, ptr %gep4
  %add = add i8 %ld4, 1
  store i8 %add, ptr %gep4
  %iv.next = add i32 %iv, 1
  %ec = icmp ne i32 %iv.next, 128
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}
