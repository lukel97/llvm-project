; CHECK-NEXT:    call void @llvm.masked.store.v4i8.p0(<4 x i8> [[TMP14]], ptr align 1 [[TMP0]], <4 x i1> [[TMP13]])
; CHECK-NEXT:    [[PREDPHI:%.*]] = select <4 x i1> [[TMP1]], <4 x i1> [[TMP3]], <4 x i1> zeroinitializer
; CHECK-NEXT:    [[PREDPHI4:%.*]] = select <4 x i1> [[TMP1]], <4 x i1> [[TMP8]], <4 x i1> zeroinitializer
