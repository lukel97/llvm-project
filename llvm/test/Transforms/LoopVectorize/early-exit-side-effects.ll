guarded1:
  %gep1 = getelementptr i8, ptr %p, i32 %iv
  %ld1 = load i8, ptr %gep1
  %ee1 = icmp eq i8 %ld1, 0
  br i1 %ee1, label %exit, label %guarded2

guarded2:
  %gep2 = getelementptr i8, ptr %r, i32 %iv
  %ld2 = load i8, ptr %gep2
  %ee2 = icmp eq i8 %ld2, 0
  br i1 %ee2, label %exit, label %store.bb

store.bb:
  %add = add i8 %ld0, 1
  store i8 %add, ptr %gep0
  br label %latch

latch:
  %iv.next = add i32 %iv, 1
  %ec = icmp ne i32 %iv.next, 128
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

; A chain of exits, but the store sits in the second exiting block itself, so
; that exit cannot dominate it and its cut comes too late.
define void @side_effect_store_between_exits(ptr dereferenceable(128) %p, ptr dereferenceable(128) %r, ptr noalias %q) {
; CHECK-LABEL: define void @side_effect_store_between_exits(
; CHECK-SAME: ptr dereferenceable(128) [[P:%.*]], ptr dereferenceable(128) [[R:%.*]], ptr noalias [[Q:%.*]]) {
; CHECK-NEXT:  [[ENTRY:.*]]:
; CHECK-NEXT:    br label %[[LOOP:.*]]
; CHECK:       [[LOOP]]:
; CHECK-NEXT:    [[IV:%.*]] = phi i32 [ 0, %[[ENTRY]] ], [ [[IV_NEXT:%.*]], %[[LATCH:.*]] ]
; CHECK-NEXT:    [[GEP1:%.*]] = getelementptr i8, ptr [[P]], i32 [[IV]]
; CHECK-NEXT:    [[LD1:%.*]] = load i8, ptr [[GEP1]], align 1
; CHECK-NEXT:    [[EE1:%.*]] = icmp eq i8 [[LD1]], 0
; CHECK-NEXT:    br i1 [[EE1]], label %[[EXIT:.*]], label %[[MID:.*]]
; CHECK:       [[MID]]:
; CHECK-NEXT:    [[GEP3:%.*]] = getelementptr i8, ptr [[Q]], i32 [[IV]]
; CHECK-NEXT:    [[LD3:%.*]] = load i8, ptr [[GEP3]], align 1
; CHECK-NEXT:    [[ADD:%.*]] = add i8 [[LD3]], 1
; CHECK-NEXT:    store i8 [[ADD]], ptr [[GEP3]], align 1
; CHECK-NEXT:    [[GEP2:%.*]] = getelementptr i8, ptr [[R]], i32 [[IV]]
; CHECK-NEXT:    [[LD2:%.*]] = load i8, ptr [[GEP2]], align 1
; CHECK-NEXT:    [[EE2:%.*]] = icmp eq i8 [[LD2]], 0
; CHECK-NEXT:    br i1 [[EE2]], label %[[EXIT]], label %[[LATCH]]
; CHECK:       [[LATCH]]:
; CHECK-NEXT:    [[IV_NEXT]] = add i32 [[IV]], 1
; CHECK-NEXT:    [[EC:%.*]] = icmp ne i32 [[IV_NEXT]], 128
; CHECK-NEXT:    br i1 [[EC]], label %[[LOOP]], label %[[EXIT]]
; CHECK:       [[EXIT]]:
; CHECK-NEXT:    ret void
;
entry:
  br label %loop

loop:
  %iv = phi i32 [ 0, %entry ], [ %iv.next, %latch ]
  %gep1 = getelementptr i8, ptr %p, i32 %iv
  %ld1 = load i8, ptr %gep1
  %ee1 = icmp eq i8 %ld1, 0
  br i1 %ee1, label %exit, label %mid

mid:
  %gep3 = getelementptr i8, ptr %q, i32 %iv
  %ld3 = load i8, ptr %gep3
  %add = add i8 %ld3, 1
  store i8 %add, ptr %gep3
  %gep2 = getelementptr i8, ptr %r, i32 %iv
  %ld2 = load i8, ptr %gep2
  %ee2 = icmp eq i8 %ld2, 0
  br i1 %ee2, label %exit, label %latch

latch:
  %iv.next = add i32 %iv, 1
  %ec = icmp ne i32 %iv.next, 128
  br i1 %ec, label %loop, label %exit

exit:
  ret void
}

; The exits chain and the store is below both, but the second exit's condition
; load isn't dereferenceable, so its own block needs masking and no cut placed
; at that exit can cover it.
define void @side_effect_second_exit_load_not_dereferenceable(ptr dereferenceable(128) %p, ptr %r, ptr noalias %q) {
; CHECK-LABEL: define void @side_effect_second_exit_load_not_dereferenceable(
